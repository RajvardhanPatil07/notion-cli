{
  "name": "notionctl",
  "version": "0.1.0",
  "description": "Conservative GitOps for Notion databases and data sources.",
  "type": "module",
  "bin": {
    "notionctl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
